class Patient:
    """Represents a clinic queue ticket without storing medical information."""

    def __init__(self, ticket_id, display_name, service):
        self.ticket_id = ticket_id
        self.display_name = display_name
        self.service = service
        self.created_at = datetime.now().strftime("%Y-%m-%d %H:%M")

    def display_info(self):
        """Instance method: return a readable summary of this ticket."""
        return (
            f"Ticket: {self.ticket_id} | "
            f"Name: {self.display_name} | "
            f"Service: {self.service} | "
            f"Registered: {self.created_at}"
        )


         class ClinicSystem:
    """Manages patient queue tickets for a clinic."""

    system_name = "KrioCare Clinic Queue Management System"
    total_registered = 0

    def __init__(self):
        # Required data structure: one list containing Patient objects.
        self.queue = []

    @staticmethod
    def is_valid_ticket_id(ticket_id):
        """Static method: check the basic format of a ticket ID."""
        return (
            isinstance(ticket_id, str)
            and ticket_id.startswith("KC-")
            and len(ticket_id) >= 6
            and ticket_id[3:].isalnum()
        )

    @classmethod
    def get_system_summary(cls):
        """Class method: access class-level information."""
        return f"{cls.system_name} | Total tickets registered: {cls.total_registered}"

    def add_patient(self, ticket_id, display_name, service):
        """Instance method: validate and add a new ticket to the queue."""
        ticket_id = ticket_id.strip().upper()
        display_name = display_name.strip()
        service = service.strip()

        if not self.is_valid_ticket_id(ticket_id):
            raise ValueError("Ticket ID must start with KC- (example: KC-001).")
        if not display_name:
            raise ValueError("Display name cannot be empty.")
        if not service:
            raise ValueError("Service cannot be empty.")
        if any(patient.ticket_id == ticket_id for patient in self.queue):
            raise ValueError("That ticket ID already exists.")

        patient = Patient(ticket_id, display_name, service)
        self.queue.append(patient)
        ClinicSystem.total_registered += 1
        return patient

    def display_queue(self):
        """Instance method: display all tickets in registration order."""
        if not self.queue:
            print("\nThe clinic queue is currently empty.")
            return

        print("\n" + "=" * 76)
        print(f"{self.system_name:^76}")
        print("=" * 76)
        for position, patient in enumerate(self.queue, start=1):
            print(f"{position:>2}. {patient.display_info()}")
        print("=" * 76)
        print(f"Patients currently waiting: {len(self.queue)}")

    def find_patient(self, ticket_id):
        """Find a queue ticket by its ID."""
        ticket_id = ticket_id.strip().upper()
        for patient in self.queue:
            if patient.ticket_id == ticket_id:
                return patient
        return None


def show_menu():
    print("\nKRIOCARE - CLINIC QUEUE MANAGEMENT")
    print("1. Register a patient")
    print("2. Display waiting queue")
    print("3. Search by ticket ID")
    print("4. Show system summary")
    print("5. Exit")


def run_demo_data(clinic):
    """Load fictional sample entries so the program can be tested quickly."""
    samples = [
        ("KC-001", "Sample Patient A", "General Consultation"),
        ("KC-002", "Sample Patient B", "Child Welfare"),
    ]
    for ticket_id, name, service in samples:
        clinic.add_patient(ticket_id, name, service)


def main():
    clinic = ClinicSystem()

    print("=" * 58)
    print(f"{ClinicSystem.system_name:^58}")
    print("A simple, privacy-conscious clinic queue prototype")
    print("=" * 58)

    while True:
        show_menu()
        choice = input("Choose an option (1-5): ").strip()

        if choice == "1":
            print("\nREGISTER NEW QUEUE TICKET")
            ticket_id = input("Enter ticket ID (e.g. KC-003): ")
            display_name = input("Enter display name (use a sample name): ")
            service = input("Enter service required: ")
            try:
                patient = clinic.add_patient(ticket_id, display_name, service)
                print("\nRegistration successful.")
                print(patient.display_info())
            except ValueError as error:
                print(f"\nRegistration failed: {error}")

        elif choice == "2":
            clinic.display_queue()

        elif choice == "3":
            ticket_id = input("Enter ticket ID to search: ")
            patient = clinic.find_patient(ticket_id)
            if patient:
                print("\nTicket found:")
                print(patient.display_info())
            else:
                print("\nNo ticket found with that ID.")

        elif choice == "4":
            print("\n" + ClinicSystem.get_system_summary())
            print(f"Tickets currently in this session: {len(clinic.queue)}")

        elif choice == "5":
            print("\nThank you for using KrioCare. Goodbye!")
            break

        else:
            print("\nInvalid choice. Please select a number from 1 to 5.")


if __name__ == "__main__":
    main()